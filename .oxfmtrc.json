{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**", "*.tgz"],
  "insertFinalNewline": true,
  "printWidth": 180,
  "semi": true,
  "singleQuote": true,
  "sortImports": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
